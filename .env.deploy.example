# VPS deploy config (template). Copy to .env.deploy and fill in your values.
# .env.deploy is gitignored.

# Public IP of the VPS. Get it from your hosting provider or `curl ifconfig.me`.
DEPLOY_HOST=

# SSH user (root for damaged-beige.ptr.network; non-root if you set up a deploy user).
DEPLOY_USER=root

# Local path to the SSH private key authorised on the VPS.
# The current dev box has /home/penis/.ssh/subbrain_deploy (ed25519).
DEPLOY_SSH_KEY=

# SSH port (default 22).
DEPLOY_PORT=22

# Remote directory where the portfolio repo lives on the VPS.
DEPLOY_REMOTE_DIR=/srv/portfolio
